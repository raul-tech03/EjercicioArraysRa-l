    private static int[] generarNotasYCalcularMinMax(Integer[] control) {
        int maxNota = 0;
        int minNota = 10;

        for (int i = 0; i < control.length; i++) {
            control[i] = (int) (Math.random() * 11);

            if (control[i] > maxNota) {
                maxNota = control[i];
            }

            if (control[i] < minNota) {
                minNota = control[i];
            }
        }
        return new int[]{minNota, maxNota};
    }
    
    private static int[][] generarListaClaseYPracticas(int numAlumnos) {
        int[] listaClase = new int[numAlumnos];
        int[] practicas = new int[numAlumnos];

        for (int i = 0; i < numAlumnos; i++) {
            listaClase[i] = i + 1;
            practicas[i] = (int) (Math.random() * 11);
        }

        return new int[][]{listaClase, practicas};
    }
    
    private static void resultado(int minNota, int maxNota,int indMinNota, int indMaxNota, int[] listaClase, List notas) {
    	
