    	  System.out.println("Indice del máximo es : " + indMaxNota);
    	  System.out.println("Lista de clase :" + Arrays.toString(listaClase));
    	  System.out.println("Array de Notas :" + notas);        
    }
    
    private static float[] vectorCalificaciones(Integer[] control, int[] practicas, int numAlumnos) {
        float[] calificaciones = new float[numAlumnos];
        for (int i = 0; i < numAlumnos; i++) {
            calificaciones[i] = ((float) control[i] + practicas[i]) / 2;
        }
        return calificaciones;
    }
     
    private static float[] estadistica(float[] calificaciones, int numAlumnos) {
        float[] estadistica = new float[10];

        for (int i = 0; i < 10; i++) {
            float count = 0;

            for (int j = 0; j < calificaciones.length; j++) {
                if (calificaciones[j] > i && calificaciones[j] <= i + 1) {
                    count++;
                }
            }

            estadistica[i] = count / numAlumnos;
        }

        return estadistica;
    }
   
    private static int[] calcularAprobadosSuspensos(float[] calificaciones, int[] aprobados, int[] suspensos) {
    	int countAprobados = 0;
    	int countSuspensos = 0;

    	for (int i = 0; i < calificaciones.length; i++) {
    	    if (calificaciones[i] < 5) {
    	        aprobados[i] = i;
    	        countAprobados++;
    	    } else {
    	        suspensos[i] = i;
    	        countSuspensos++;
    	    }
    	}
    	
        return new int[]{countAprobados, countSuspensos};
    }
    
    private static int[][] resumirAprobadosSuspensos(int[] aprobados, int[] suspensos, int countAprobados, int countSuspensos) {
        
        int[] a = new int[countAprobados];
        int[] s = new int[countSuspensos];
        int x = 0;
        
        for (int i = 0; i < aprobados.length; i++) {
            if (aprobados[i] != 0) {
                a[x++] = aprobados[i];
            }
        }
        
        x = 0;
        for (int i = 0; i < suspensos.length; i++) {
            if (suspensos[i] != 0) {
                s[x++] = suspensos[i];
            }
        }        
        return new int[][] { a, s };
    }
    
    private static double[] calificacion() {
        double[] calif = new double[40];
        
        for (int j = 0; j < 31; j++) {
            calif[j] = (int)(Math.random() * 11);
        }
        
        return calif;
    }    
